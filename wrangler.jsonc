{
  // Sample worker config. Rename agentic-assistant on clone, then run
  // wrangler deploy from the pack root.
  "name": "agentic-assistant",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PACK_NAME": "agentic-assistant"
  }
}
